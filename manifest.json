{
  "manifest_version": 3,
  "name": "Bilibili Digest",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "description": "Turn Bilibili videos into learning resources with Chinese subtitles, AI overviews, and notes.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "cookies",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.bilivideo.com/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "Open Bilibili Digest",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["platform.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
